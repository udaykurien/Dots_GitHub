function search_cheats() {
	echo "Searching in $cheats_loc :"
	cd $cheats_loc 						# change directory to truncate grep path output
	find ./ -iname $1 
	grep --color -ri $1 ./
	cd - 1>/dev/null					# return to starting dir
}

