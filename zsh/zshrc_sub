# General purpose functions:
# Loop:
function monitor () {
	echo -e "${YELLOWB}USAGE: monitor [command] [run_time] [refresh_interval]${RESET}"
	cmnd=$1; net_time=$2; intrvl_time=$3
	current_iter=0;	total_iter=$(($net_time/$intrvl_time))
	while [ $current_iter -lt $total_iter ]
	do
		echo -e "${WHITEBG}$current_iter. Time - $(date +'%H:%M:%S')${RESET}"
		eval $cmnd
		current_iter=$((current_iter+1))
		sleep $3
	done
}

